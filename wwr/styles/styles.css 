/* Reset default browser styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Body styling */
body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    background-color: #f4f4f4;
    color: #333;
}

/* Header & Navigation */
header {
    background-color: #1e90ff; /* steel blue */
    padding: 10px 20px;
}

nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
}

nav img {
    height: 50px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 15px;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

/* Main content */
main {
    max-width: 900px;
    margin: 20px auto;
    padding: 20px;
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

main h1, main h2 {
    color: #1e90ff;
    margin-bottom: 10px;
}

main section {
    margin-bottom: 20px;
}

main p {
    padding: 5px 0;
}

/* Footer */
footer {
    text-align: center;
    padding: 15px;
    background-color: #1e90ff;
    color: white;
    margin-top: 20px;
}