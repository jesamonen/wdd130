/* Universal reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* CSS variables */
:root {
    --primary-color: #1e90ff;
    --accent-color: #ff6600;
}

/* Navigation */
nav {
    background-color: var(--primary-color);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}

nav img {
    height: 50px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 15px;
    display: block;
}

nav a:hover {
    text-decoration: underline;
}

/* Hero Section */
.hero {
    position: relative;
    background-color: #f0f8ff;
    padding: 20px;
    margin-bottom: 20px;
}

.hero h1 {
    position: absolute;
    top: 20px;
    left: 20px;
    color: var(--primary-color);
    font-size: 2rem;
}

.hero article {
    position: absolute;
    top: 80px;
    left: 20px;
    width: 60%;
}

.hero article img {
    float: right;
    width: 150px;
    height: auto;
    margin-left: 10px;
}

/* Main content */
main {
    max-width: 900px;
    margin: 20px auto;
    padding: 20px;
    background-color: white;
    border-radius: 8px;
}

h2 {
    color: var(--primary-color);
    margin-bottom: 10px;
}

p {
    padding: 5px 0;
}

/* Footer */
footer {
    text-align: center;
    padding: 15px;
    background-color: var(--primary-color);
    color: white;
}

footer .socialmedia a img {
    width: 30px;
    height: 30px;
    margin: 0 5px;
}