
/* CSS VARIABLES */

:root {
    --primary-color: #1e90ff;
    --accent1-color: #ff6600;
    --text-color: #333;
    --bg-color: #f4f4f4;
    --white: #ffffff;
}


/* RESET */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* BODY */

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    background-color: var(--bg-color);
    color: var(--text-color);
}


/* HEADER & NAVIGATION */

header {
    background-color: var(--primary-color);
    padding: 10px 20px;
}

nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
}

nav img {
    height: 50px;
}

nav a {
    color: var(--white);
    text-decoration: none;
    margin-left: 15px;
    font-weight: bold;
    transition: color 0.3s ease;
}

nav a:hover {
    color: var(--accent1-color); /* 
}
h1 {
  position: absolute;
  top: 20px;
  width: 100%;
  padding: 16px;
  text-align: center;
  opacity: 0.7;
  background-color: var(--accent1-color);
  color: #fff;
}

/* MAIN CONTENT */

main {
    max-width: 900px;
    margin: 20px auto;
    padding: 20px;
    background-color: var(--white);
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

main h1,
main h2 {
    color: var(--primary-color);
    margin-bottom: 10px;
}

main section {
    margin-bottom: 20px;
}

main p {
    padding: 5px 0;
}


/* HERO SECTION */

.hero {
    position: relative;
    height: 400px;
    background-image: url('../images/z-splash.png');
    background-size: cover;
    background-position: center;
}

.hero h1 {
    position: absolute;
    top: 20px;
    left: 20px;
    color: var(--white);
}

.hero article {
    position: absolute;
    bottom: 20px;
    left: 20px;
    width: 60%;
    color: var(--white);
}

.hero article img {
    float: right;
    margin-left: 15px;
    max-width: 200px;
}


/* SOCIAL MEDIA */

.socialmedia a {
    text-decoration: none;
    margin: 0 10px;
    color: var(--primary-color);
    transition: color 0.3s ease;
}

.socialmedia a:hover {
    color: var(--accent1-color);
}


/* FOOTER */

footer {
    text-align: center;
    padding: 15px;
    background-color: var(--primary-color);
    color: var(--white);
    margin-top: 20px;
}